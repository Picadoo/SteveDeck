#!/bin/sh
# 推送前门禁（约 15-30s）：全仓类型检查 + 引擎纯逻辑单测 + UI 单测 + 版本位点一致性。
# 是 CI 的快速子集（不含 build/端到端/Docker）——CI 红之前本地先红，省一轮往返。
# 临时跳过本次检查：git push --no-verify
fail() {
  echo "" >&2
  echo "✖ 推送门禁未通过：$1（临时跳过：git push --no-verify）" >&2
  exit 1
}
pnpm typecheck || fail "typecheck"
pnpm --filter @mcbot/engine test:unit || fail "引擎单测"
pnpm --filter @mcbot/ui test || fail "UI 单测"
node scripts/bump-version.mjs --check || fail "版本一致性"
