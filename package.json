{
  "name": "stevedeck",
  "private": true,
  "version": "0.1.3",
  "description": "面向玩家的 Minecraft 挂机机器人：Docker 引擎 + Tauri 桌面/安卓客户端",
  "author": "Picadoo",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/Picadoo/SteveDeck#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Picadoo/SteveDeck.git"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:all": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write .",
    "test": "pnpm build && pnpm --filter @mcbot/engine test:unit && pnpm --filter @mcbot/ui test && pnpm --filter @mcbot/engine test",
    "bump": "node scripts/bump-version.mjs",
    "prepare": "node -e \"try{require('fs').statSync('.git');require('child_process').execSync('git config core.hooksPath .githooks')}catch(e){}\"",
    "start:engine": "pnpm --filter @mcbot/engine start",
    "dev:engine": "pnpm --filter @mcbot/engine dev",
    "dev:ui": "pnpm --filter @mcbot/ui dev",
    "build:ui": "pnpm --filter @mcbot/ui build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "typescript": "^5.6.3"
  }
}
